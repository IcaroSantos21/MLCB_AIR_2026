import numpy as np
import pandas as pd

from sklearn.linear_model import LogisticRegression
from sklearn.neighbors import KNeighborsClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

df = pd.read_csv("sac_moveis_ac2.csv")

print("Dataset carregado!")
print("\nColunas disponíveis:")
print(df.columns.tolist())

print("\nQuantidade de registros:", len(df))

X_texto = df["mensagem"]

y = df["intencao"]

X_vetores = np.array([
    obter_vetor_frase(msg, fasttext_model)
    for msg in X_texto
])

print("\nFormato dos embeddings:")
print(X_vetores.shape)

X_train, X_test, y_train, y_test = train_test_split(
    X_vetores,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nDivisão dos dados:")
print("Treino:", X_train.shape)
print("Teste :", X_test.shape)



print("\nTreinando Regressão Logística...")

modelo_regressao = LogisticRegression(
    max_iter=1000,
    random_state=42
)

modelo_regressao.fit(X_train, y_train)

print("Regressão Logística treinada!")




print("\nTreinando KNN com K=3...")

# TODO 1: Instanciar e treinar o KNN
modelo_knn = KNeighborsClassifier(
    n_neighbors=3
)

modelo_knn.fit(X_train, y_train)

print("KNN treinado!")



y_pred_linear = modelo_regressao.predict(X_test)

y_pred_knn = modelo_knn.predict(X_test)



# TODO 2: Calcular a acurácia de cada modelo

acuracia_linear = accuracy_score(
    y_test,
    y_pred_linear
)

acuracia_knn = accuracy_score(
    y_test,
    y_pred_knn
)


print("\n========================================")
print("COMPARAÇÃO DOS MODELOS")
print("========================================")

print(
    f"Acurácia - Regressão Logística (Linear): "
    f"{acuracia_linear:.2%}"
)

print(
    f"Acurácia - KNN (Distância K=3): "
    f"{acuracia_knn:.2%}"
)


print("\n========================================")
print("MODELO COM MELHOR DESEMPENHO")
print("========================================")

if acuracia_knn > acuracia_linear:

    diferenca = acuracia_knn - acuracia_linear

    print("KNN apresentou a maior acurácia.")
    print(f"Diferença: {diferenca:.2%}")

elif acuracia_linear > acuracia_knn:

    diferenca = acuracia_linear - acuracia_knn

    print("Regressão Logística apresentou a maior acurácia.")
    print(f"Diferença: {diferenca:.2%}")

else:

    print("Os dois modelos apresentaram a mesma acurácia.")

print("\n========================================")
print("COMPARAÇÃO NA BASE COMPLETA")
print("========================================")

# Treinar modelos novamente usando todos os dados

modelo_regressao_completo = LogisticRegression(
    max_iter=1000,
    random_state=42
)

modelo_regressao_completo.fit(
    X_vetores,
    y
)

modelo_knn_completo = KNeighborsClassifier(
    n_neighbors=3
)

modelo_knn_completo.fit(
    X_vetores,
    y
)


# Predições na própria base de treinamento

y_pred_linear_completo = (
    modelo_regressao_completo.predict(X_vetores)
)

y_pred_knn_completo = (
    modelo_knn_completo.predict(X_vetores)
)


# Acurácias

acuracia_linear_completo = accuracy_score(
    y,
    y_pred_linear_completo
)

acuracia_knn_completo = accuracy_score(
    y,
    y_pred_knn_completo
)

print(
    f"Regressão Logística: "
    f"{acuracia_linear_completo:.2%}"
)

print(
    f"KNN K=3: "
    f"{acuracia_knn_completo:.2%}"
)


def testar_mensagem(mensagem):
    """
    Classifica uma nova mensagem usando os dois modelos.
    """

    # Transformar a frase em embedding
    vetor = obter_vetor_frase(
        mensagem,
        fasttext_model
    ).reshape(1, -1)


    # Previsão da Regressão Logística
    previsao_linear = modelo_regressao.predict(vetor)[0]


    # Previsão do KNN
    previsao_knn = modelo_knn.predict(vetor)[0]


    print("\n----------------------------------------")
    print("Mensagem:", mensagem)
    print("----------------------------------------")

    print(
        "Regressão Logística:",
        previsao_linear
    )

    print(
        "KNN (K=3):",
        previsao_knn
    )

