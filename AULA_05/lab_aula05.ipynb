frase_teste = "       Gostaria de saber se vocês estão DEVOLVENDO os valores das mesas compradas!!!       "
print("Frase Original:", frase_teste)
print("Frase Limpa & Lemmatizada:", limpar_e_lemmatizar(frase_teste))

