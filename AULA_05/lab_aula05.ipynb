    "Quero saber o valor do frete do sofá",
    "Gostaria de trocar minha mesa",
    "Qual o prazo de entrega do meu pedido?",
    "Quero comprar um guarda roupa"
]


print("\n========================================")
print("TESTES COM NOVAS FRASES")
