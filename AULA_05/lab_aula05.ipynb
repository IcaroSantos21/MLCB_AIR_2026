X_train, X_test, y_train, y_test = train_test_split(X_vetores, y, test_size=0.20, random_state=42, stratify=y)

print("\nDados separados:")
print("Treino:", X_train.shape)
print("Teste :", X_test.shape)

print("\nTreinando classificador...")

modelo = LogisticRegression(
    max_iter=1000,
