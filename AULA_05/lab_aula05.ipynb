for mensagem in testes:
    testar_mensagem(mensagem)

print("\n========================================")
print("CLASSIFICAÇÃO INTERATIVA")
print("========================================")

while True:

    mensagem = input(
        "\nDigite uma mensagem "
        "(ou 'sair' para encerrar): "
    )

    if mensagem.lower() == "sair":

        print("Programa encerrado.")
