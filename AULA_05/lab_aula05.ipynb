def prever_mensagem(mensagem):
    """
    Recebe uma nova mensagem e retorna a classe prevista.
    """

    # Transformar a mensagem em embedding
    vetor = obter_vetor_frase(
        mensagem,
        fasttext_model
    )

    # O modelo espera uma matriz:
    # (quantidade_de_exemplos, dimensões)
    vetor = vetor.reshape(1, -1)

    # Fazer previsão
    previsao = modelo.predict(vetor)[0]

    # Probabilidades
    probabilidades = modelo.predict_proba(vetor)[0]

    # Maior probabilidade
    confianca = np.max(probabilidades)

    return previsao, confianca

